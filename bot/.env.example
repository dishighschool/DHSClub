# Discord Developer Portal 的 Bot Token
DISCORD_TOKEN=

# 選填：設定後 slash commands 會立即註冊到指定伺服器；未設定時註冊為全域指令
DISCORD_GUILD_ID=

# OpenAI 相容 API
AI_API_KEY=
AI_BASE_URL=https://ai.tfdst.xyz/v1

# 選填：固定預設模型；留空時會從 /models 自動選擇可用的文字對話模型
AI_MODEL=

# 選填設定
AI_TIMEOUT_MS=45000
BOT_MAX_CONTEXT_MESSAGES=20
SUMMARY_MAX_MESSAGES=300
HISTORY_MAX_MESSAGES=200
